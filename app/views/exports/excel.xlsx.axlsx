# =============================================================================
# EXCEL EXPORT TEMPLATE
# =============================================================================
# This file is processed by caxlsx_rails to generate the .xlsx file. It is
# PURE RUBY (the axlsx template handler runs the raw file content directly
# as Ruby, unlike .erb) — no <% %> tags here.
# `wb` is the Axlsx::Package workbook — available automatically via caxlsx_rails.
# =============================================================================
#
# HOW THIS FILE WORKS (for readers new to Ruby/axlsx):
# Rails picks this template because its filename ends in ".xlsx.axlsx" — the
# "axlsx" part tells Rails/caxlsx_rails to treat the WHOLE file as a plain
# Ruby script (not HTML like a normal view), run it, and turn the result into
# a downloadable Excel workbook. There's no HTML markup at all in this file —
# every line below is regular Ruby code calling methods provided by the
# "axlsx" gem (a library for building .xlsx spreadsheets programmatically).
# "#" starts a comment in Ruby — everything after "#" on a line is ignored
# by Ruby and exists only for human readers, just like this header itself.

# `xlsx_package` is a special object caxlsx_rails automatically makes
# available inside this template — it represents the whole Excel FILE being
# built. `.workbook` gets the Axlsx::Workbook object inside that package — a
# "workbook" is Excel's term for the entire spreadsheet file, which can
# contain multiple worksheets (tabs). `wb =` stores it in a local variable
# named `wb` so the rest of this file can refer to it without retyping
# `xlsx_package.workbook` every time.
wb = xlsx_package.workbook

  # ---------------------------------------------------------------------------
  # STYLES
  # ---------------------------------------------------------------------------
  # Excel "styles" are reusable formatting definitions (colors, bold, number
  # formats, borders) that you build once and then apply to cells by
  # reference, instead of repeating formatting options on every cell. Each
  # `wb.styles.add_style(...)` call below registers one style with the
  # workbook and returns a style ID/object, saved into a local variable so
  # it can be reused later when writing rows.

  # `header_style` will be applied to the very first row (the column titles).
  # `add_style` takes a Ruby Hash of formatting options — the `{` isn't
  # written explicitly here because Ruby lets you pass a trailing hash as
  # keyword-style arguments without braces when calling a method.
  header_style = wb.styles.add_style(
    bg_color:  "1F2937",     # Dark background — hex color for the cell's fill/background
    fg_color:  "D1FAE5",     # Emerald text — hex color for the cell's font/text color
    b:         true,         # Bold — `b:` is axlsx's shorthand for bold text, true turns it on
    sz:        11,           # Font size in points
    border:    { style: :thin, color: "374151" }
    # `border:` takes its own nested hash: `style: :thin` draws a thin line
    # (`:thin` is a Ruby "symbol" — a lightweight, immutable label, similar
    # to a string but used for fixed internal names rather than
    # user-facing text), and `color:` sets that border line's hex color.
  )
  # The closing `)` above ends the argument list opened by `add_style(` on
  # the `header_style = ...` line.

  # `price_green_style` is meant to highlight a unit's price as a GOOD deal
  # (see `unit.price_color_class` further down, which decides which of the
  # three price_* styles applies to a given row).
  price_green_style = wb.styles.add_style(
    fg_color: "10B981",   # Emerald-500 — green text color
    b:        true,       # Bold text
    num_fmt:  7   # built-in Excel currency format ($#,##0.00)
    # `num_fmt:` picks one of Excel's predefined numeric display formats by
    # ID number; 7 is Excel's built-in "currency with 2 decimals" format, so
    # a raw number like 89.5 displays as "$89.50" in the spreadsheet.
  )
  # Closes the add_style(...) call above.

  # `price_yellow_style` highlights a price that's a middling/average deal.
  price_yellow_style = wb.styles.add_style(
    fg_color: "F59E0B",   # Amber-500 — orange/yellow text color
    b:        true,       # Bold text
    num_fmt:  7   # built-in Excel currency format ($#,##0.00)
  )
  # Closes the add_style(...) call above.

  # `price_red_style` highlights a price that's a poor/expensive deal.
  price_red_style = wb.styles.add_style(
    fg_color: "EF4444",   # Red-500 — red text color
    b:        true,       # Bold text
    num_fmt:  7   # built-in Excel currency format ($#,##0.00)
  )
  # Closes the add_style(...) call above.

  # `default_style` is the plain/neutral style used for ordinary text cells
  # that don't need any special color-coding (company name, address, etc.).
  default_style = wb.styles.add_style(
    fg_color: "D1D5DB",   # Light gray text color
    sz:       10          # Font size in points, slightly smaller than the header
  )
  # Closes the add_style(...) call above.

  # `date_style` formats the "Date Collected" column so raw date values show
  # up as readable calendar dates instead of Excel's internal date number.
  date_style = wb.styles.add_style(
    fg_color: "9CA3AF",   # Muted gray text color
    sz:       9,          # Font size in points
    num_fmt:  14   # mm/dd/yy date format
    # 14 is another built-in Excel number-format ID, this one for dates
    # formatted like "07/18/26".
  )
  # Closes the add_style(...) call above.

  # ---------------------------------------------------------------------------
  # WORKSHEET: Results
  # ---------------------------------------------------------------------------
  # `add_worksheet` creates one tab/sheet inside the workbook named "Storage
  # Prices". `do |ws| ... end` is a Ruby BLOCK — a chunk of code passed into
  # the `add_worksheet` method that it runs on our behalf, handing back a new
  # worksheet object through the block variable `ws` (short for "worksheet")
  # so we can add rows/columns to it inside the block.
  wb.add_worksheet(name: "Storage Prices") do |ws|
    # Header row
    # `ws.add_row` appends one row of cells to the worksheet. The argument
    # is a Ruby Array (a list, written with `[...]` and comma-separated
    # items) of column title strings — one string per column, in
    # left-to-right order. `style: header_style` applies the header style
    # built above to every cell in this row.
    ws.add_row [
      "Company", "Facility", "Address", "City", "State", "ZIP",
      "Phone", "Distance (mi)", "Size", "Sq Ft",
      "Monthly Price", "Web Special", "Web Special Note",
      "Climate Controlled", "Available", "Booking URL", "Date Collected"
    ], style: header_style

    # Freeze the header row so it stays visible when scrolling
    # `ws.sheet_view.pane` configures Excel's "freeze panes" feature via
    # another block, this time yielding a pane-settings object `p`.
    ws.sheet_view.pane do |p|
      p.state        = :frozen   # Turns on frozen panes (as opposed to a plain split view)
      p.y_split      = 1         # Freeze after the 1st row (keeps the header pinned while scrolling)
      p.top_left_cell = "A2"     # First visible/scrollable cell once frozen — just below the header
    end
    # `end` closes the `do |p| ... end` block opened by `ws.sheet_view.pane`.

    # Data rows
    # `@units` is an instance variable — set by the controller action that
    # rendered this export (it is NOT defined anywhere in this file), and is
    # visible here because Rails view templates automatically share
    # instance variables with their controller. `.each` iterates over the
    # collection one item at a time; `do |unit| ... end` is again a block,
    # run once per unit, with `unit` holding the current Unit record.
    @units.each do |unit|
      # `f` is a local variable holding this unit's associated Facility
      # record, fetched via the `facility` association method on `unit`.
      f = unit.facility

      # Choose price style based on price color
      # `case ... when ... end` is Ruby's multi-branch conditional — it
      # compares `unit.price_color_class` against each `when` value in turn
      # and evaluates the matching branch; `else` covers anything that
      # doesn't match any `when`. The whole `case` expression's result
      # (whichever branch ran) is assigned into `price_style`.
      price_style = case unit.price_color_class
      when "price-green"  then price_green_style
      when "price-yellow" then price_yellow_style
      when "price-red"    then price_red_style
      else                     default_style
      end
      # `end` closes the `case` expression started above.

      # Builds one spreadsheet row for this unit. The three arrays below —
      # values, styles, and types — are positional: the Nth value uses the
      # Nth style and is written as the Nth type, so all three arrays must
      # stay in the same column order as the header row above.
      ws.add_row [
        f.company,               # Storage company name
        f.name,                  # Facility name
        f.address,               # Street address
        f.city,                  # City
        f.state,                 # State abbreviation
        f.zip,                   # ZIP code
        f.formatted_phone,       # Phone number, pre-formatted for display
        f.distance_miles,        # Distance from the search location, in miles
        unit.size,                # Unit size label (e.g. "10x10")
        unit.sqft,                # Unit square footage
        unit.monthly_price,       # Regular monthly rental price
        unit.web_special_price,   # Discounted "web special" price, if any
        unit.web_special_note,    # Free-text note describing the web special
        # `? :` here is Ruby's TERNARY operator — shorthand for an if/else
        # that fits on one line: `condition ? value_if_true :
        # value_if_false`. `unit.climate_controlled?` is a boolean method
        # (methods ending in `?` return true/false by convention), so this
        # line reads as "Yes" if the unit is climate controlled, else "No".
        unit.climate_controlled? ? "Yes" : "No",
        # Same ternary pattern, checking whether the unit is currently
        # available for rent.
        unit.available? ? "Yes" : "No",
        unit.booking_url,         # URL to book/reserve this unit online
        unit.collected_at         # Timestamp this data was scraped/collected
      ], style: [
        # One style per column above, in the same order — most columns use
        # the plain `default_style`; the two price columns (Monthly Price,
        # Web Special) use whichever `price_style` was picked by the `case`
        # statement above (green/yellow/red/default); the last column
        # (Date Collected) uses `date_style` so it renders as a date.
        default_style, default_style, default_style, default_style,
        default_style, default_style, default_style, default_style,
        default_style, default_style, price_style,   price_style,
        default_style, default_style, default_style, default_style,
        date_style
      ], types: [
        # One TYPE per column, again in the same order. These are Ruby
        # symbols (`:string`, `:float`, etc.) that tell axlsx how to
        # interpret/store each cell's raw value internally so Excel treats
        # it as text, a decimal number, a whole number, or a date rather
        # than guessing.
        :string, :string, :string, :string,
        :string, :string, :string, :float,
        :string, :integer, :float, :float,
        :string, :string, :string, :string,
        :date
      ]
      # Closes the `ws.add_row [...], style: [...], types: [...]` call
      # started above.
    end
    # `end` closes the `@units.each do |unit| ... end` loop started above.

    # Auto-fit column widths (approximate)
    # `ws.column_info` is a zero-indexed list of per-column settings for
    # this worksheet — `column_info[0]` is the FIRST column ("Company"),
    # `column_info[1]` is the second ("Facility"), and so on, matching the
    # header row order above. Setting `.width =` on each one manually
    # approximates auto-fit since axlsx doesn't compute real auto-fit widths.
    ws.column_info[0].width  = 22   # Company
    ws.column_info[1].width  = 28   # Facility
    ws.column_info[2].width  = 24   # Address
    ws.column_info[3].width  = 14   # City
    ws.column_info[4].width  = 6    # State
    ws.column_info[5].width  = 8    # ZIP
    ws.column_info[6].width  = 14   # Phone
    ws.column_info[7].width  = 10   # Distance
    ws.column_info[8].width  = 8    # Size
    ws.column_info[9].width  = 7    # Sq Ft
    ws.column_info[10].width = 12   # Monthly Price
    ws.column_info[11].width = 12   # Web Special
    ws.column_info[12].width = 20   # Web Special Note
    ws.column_info[13].width = 10   # Climate
    ws.column_info[14].width = 10   # Available
    ws.column_info[15].width = 35   # Booking URL
    ws.column_info[16].width = 16   # Date
  end
# `end` closes the `wb.add_worksheet(...) do |ws| ... end` block that
# started the "Storage Prices" worksheet — everything above, from the
# header row through the column widths, happens inside this block.
