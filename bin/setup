#!/usr/bin/env bash
# =============================================================================
# STORAGEFINDER — SETUP SCRIPT
# =============================================================================
# Run this ONCE on any new machine to install everything.
# Works on: WSL (Ubuntu), Linux (Ubuntu/Debian), macOS
#
# Usage:
#   bash bin/setup
#
# What it does:
#   1. Detects your OS
#   2. Installs all required system libraries
#   3. Installs/verifies Node.js
#   4. Installs Ruby gems (bundle install)
#   5. Sets up the database
#   6. Installs Playwright + Chromium browser
#   7. Makes start.sh executable
# =============================================================================

set -e  # Stop immediately if any command fails unexpectedly

# Color output helpers — makes the script easier to read
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color (reset)

ok()   { echo -e "${GREEN}  ✓ $1${NC}"; }
info() { echo -e "${BLUE}  → $1${NC}"; }
warn() { echo -e "${YELLOW}  ⚠ $1${NC}"; }
fail() { echo -e "${RED}  ✗ $1${NC}"; exit 1; }
header() { echo -e "\n${BOLD}$1${NC}"; }

# Go to the project root regardless of where this script was called from
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_ROOT"

echo ""
echo -e "${BOLD}╔═══════════════════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║           StorageFinder — First-time Setup                ║${NC}"
echo -e "${BOLD}╚═══════════════════════════════════════════════════════════╝${NC}"
echo ""

# =============================================================================
# STEP 0: DETECT OPERATING SYSTEM
# =============================================================================
header "Detecting operating system..."

IS_MAC=false
IS_LINUX=false
IS_WSL=false

if [[ "$OSTYPE" == "darwin"* ]]; then
  IS_MAC=true
  ok "macOS detected"
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
  IS_LINUX=true
  # Check if running inside WSL
  if grep -qi "microsoft\|wsl" /proc/version 2>/dev/null; then
    IS_WSL=true
    ok "WSL (Windows Subsystem for Linux) detected"
    warn "storagefinder.local LAN hostname won't work in WSL — use localhost:5555 instead"
  else
    ok "Linux detected"
  fi
else
  fail "Unsupported OS: $OSTYPE — this script supports macOS and Linux/WSL only"
fi

# =============================================================================
# STEP 1: INSTALL SYSTEM DEPENDENCIES
# =============================================================================
header "Step 1: Installing system dependencies..."

if $IS_MAC; then
  # --- macOS via Homebrew ---
  
  # Check if Homebrew is installed
  if ! command -v brew &>/dev/null; then
    info "Homebrew not found — installing it now..."
    info "This will ask for your password"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    # Add brew to PATH for this session (Apple Silicon vs Intel path)
    if [[ -f "/opt/homebrew/bin/brew" ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f "/usr/local/bin/brew" ]]; then
      eval "$(/usr/local/bin/brew shellenv)"
    fi
    ok "Homebrew installed"
  else
    ok "Homebrew already installed"
  fi

  info "Installing system packages via Homebrew..."
  # brew install is idempotent — safe to run even if already installed
  brew install git curl node sqlite3 pkg-config 2>/dev/null || true
  ok "System packages installed"
  # Note: macOS has Bonjour (dnssd) built in — no separate install needed
  ok "mDNS/Bonjour already built into macOS"

elif $IS_LINUX || $IS_WSL; then
  # --- Linux / WSL via apt ---

  # Check if we can use sudo
  if ! command -v sudo &>/dev/null; then
    fail "sudo is required but not found. Please install sudo or run as root."
  fi

  info "Updating package lists (this may take a moment)..."
  sudo apt-get update -qq

  info "Installing system packages..."
  sudo apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    zlib1g-dev \
    libsqlite3-dev \
    libavahi-compat-libdnssd-dev \
    git \
    curl \
    ca-certificates \
    gnupg \
    2>/dev/null

  ok "System packages installed"
fi

# =============================================================================
# STEP 2: CHECK / INSTALL NODE.JS
# =============================================================================
header "Step 2: Checking Node.js..."

NODE_MIN_VERSION=18

if command -v node &>/dev/null; then
  NODE_VERSION=$(node --version | sed 's/v//' | cut -d. -f1)
  if [ "$NODE_VERSION" -ge "$NODE_MIN_VERSION" ]; then
    ok "Node.js $(node --version) already installed"
  else
    warn "Node.js $(node --version) is too old (need v${NODE_MIN_VERSION}+) — upgrading..."
    INSTALL_NODE=true
  fi
else
  info "Node.js not found — installing..."
  INSTALL_NODE=true
fi

if [ "${INSTALL_NODE:-false}" = true ]; then
  if $IS_MAC; then
    brew install node
    ok "Node.js installed via Homebrew"
  elif $IS_LINUX || $IS_WSL; then
    # Use NodeSource to get a recent version (apt default is often too old)
    info "Adding NodeSource repository for Node.js 20 LTS..."
    curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash - 2>/dev/null
    sudo apt-get install -y nodejs 2>/dev/null
    ok "Node.js $(node --version) installed"
  fi
fi

# npm comes with node but verify it's there
if ! command -v npm &>/dev/null; then
  fail "npm not found after Node.js install — something went wrong. Try: sudo apt-get install npm"
fi
ok "npm $(npm --version) available"

# =============================================================================
# STEP 3: CHECK RUBY VERSION
# =============================================================================
header "Step 3: Checking Ruby..."

if ! command -v ruby &>/dev/null; then
  fail "Ruby not found. Install Ruby 3.2+ first.\n  Linux/WSL: sudo apt-get install ruby-full\n  Mac: brew install ruby\n  Or use a version manager: https://mise.jdx.dev"
fi

RUBY_VERSION=$(ruby --version | grep -oP '\d+\.\d+\.\d+' | head -1)
RUBY_MAJOR=$(echo $RUBY_VERSION | cut -d. -f1)
RUBY_MINOR=$(echo $RUBY_VERSION | cut -d. -f2)

ok "Ruby $RUBY_VERSION found"

if [ "$RUBY_MAJOR" -lt 3 ] || ([ "$RUBY_MAJOR" -eq 3 ] && [ "$RUBY_MINOR" -lt 2 ]); then
  fail "Ruby $RUBY_VERSION is too old. StorageFinder requires Ruby 3.2 or newer.\n  Install a newer version with: mise install ruby@latest"
fi

# Update Gemfile to match the exact Ruby version installed
# This prevents "Your Ruby version is X but Gemfile specified Y" errors
CURRENT_RUBY=$(ruby --version | grep -oP '\d+\.\d+\.\d+' | head -1)
if grep -q "^ruby \"" Gemfile; then
  GEMFILE_RUBY=$(grep "^ruby \"" Gemfile | grep -oP '\d+\.\d+\.\d+')
  if [ "$CURRENT_RUBY" != "$GEMFILE_RUBY" ]; then
    info "Updating Gemfile Ruby version from $GEMFILE_RUBY to $CURRENT_RUBY..."
    sed -i.bak "s/ruby \"$GEMFILE_RUBY\"/ruby \"$CURRENT_RUBY\"/" Gemfile
    rm -f Gemfile.bak
    ok "Gemfile updated to Ruby $CURRENT_RUBY"
  fi
fi

# =============================================================================
# STEP 4: INSTALL BUNDLER AND GEMS
# =============================================================================
header "Step 4: Installing Ruby gems..."

# Install/update Bundler itself
info "Checking Bundler..."
if ! command -v bundle &>/dev/null; then
  gem install bundler --quiet
  ok "Bundler installed"
else
  ok "Bundler $(bundle --version | grep -oP '\d+\.\d+\.\d+') already installed"
fi

# Install all gems from Gemfile
info "Running bundle install (this may take several minutes the first time)..."
if bundle install; then
  ok "All gems installed successfully"
else
  fail "bundle install failed. Check the error above.\nCommon fixes:\n  - Missing system library: re-run this setup script\n  - Network issue: check your internet connection\n  - Gem not found: check Gemfile for typos"
fi

# =============================================================================
# STEP 5: SET UP DATABASE
# =============================================================================
header "Step 5: Setting up database..."

info "Creating database and running migrations..."
if bundle exec rails db:prepare 2>&1; then
  ok "Database ready"
else
  fail "Database setup failed. Check the error above."
fi

# Seed default settings only if the settings table is empty
SETTINGS_COUNT=$(bundle exec rails runner "puts Setting.count" 2>/dev/null || echo "0")
if [ "$SETTINGS_COUNT" = "0" ]; then
  info "Seeding default settings..."
  bundle exec rails db:seed
  ok "Default settings seeded"
else
  ok "Settings already seeded ($SETTINGS_COUNT settings found)"
fi

# =============================================================================
# STEP 6: INSTALL PLAYWRIGHT + CHROMIUM
# =============================================================================
header "Step 6: Installing Playwright browser automation..."

# Install the Playwright CLI globally via npm
if ! command -v playwright &>/dev/null; then
  info "Installing Playwright CLI..."
  npm install -g playwright 2>/dev/null
  ok "Playwright CLI installed"
else
  ok "Playwright CLI already installed ($(playwright --version 2>/dev/null || echo 'version unknown'))"
fi

# Install Chromium browser (the one Playwright uses for crawling)
info "Installing Chromium browser for Playwright..."
info "(This downloads ~200MB of browser files — only needed once per machine)"
if playwright install chromium 2>/dev/null; then
  ok "Chromium installed"
else
  warn "Chromium install may have had issues — trying with npx..."
  npx playwright install chromium 2>/dev/null || \
    warn "Chromium install failed. The app will start but crawling won't work until you run: playwright install chromium"
fi

# Install system dependencies Playwright needs (fonts, graphics libs, etc.)
if $IS_LINUX || $IS_WSL; then
  info "Installing Playwright system dependencies..."
  playwright install-deps chromium 2>/dev/null || \
    npx playwright install-deps chromium 2>/dev/null || \
    warn "Could not install Playwright system deps automatically. If crawling fails, run: sudo playwright install-deps chromium"
fi

# =============================================================================
# STEP 7: CREATE DIRECTORIES AND PERMISSIONS
# =============================================================================
header "Step 7: Final setup..."

mkdir -p logs recon tmp/pids tmp/cache tmp/sockets
ok "Directories created (logs/, recon/, tmp/)"

chmod +x start.sh bin/rails bin/rake bin/setup
ok "Scripts made executable"

# Clean up any leftover Gemfile backup
rm -f Gemfile.bak

# =============================================================================
# DONE
# =============================================================================
echo ""
echo -e "${BOLD}╔═══════════════════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║                  Setup Complete! 🎉                       ║${NC}"
echo -e "${BOLD}╠═══════════════════════════════════════════════════════════╣${NC}"
echo -e "${BOLD}║                                                           ║${NC}"
echo -e "${BOLD}║  To start the app:   ./start.sh                          ║${NC}"
if $IS_WSL; then
echo -e "${BOLD}║                                                           ║${NC}"
echo -e "${BOLD}║  Then open:          http://localhost:5555                ║${NC}"
echo -e "${BOLD}║  (WSL: use localhost — storagefinder.local needs Linux)   ║${NC}"
else
echo -e "${BOLD}║                                                           ║${NC}"
echo -e "${BOLD}║  Then open:          http://localhost:5555                ║${NC}"
echo -e "${BOLD}║         or:          http://storagefinder.local           ║${NC}"
fi
echo -e "${BOLD}║                                                           ║${NC}"
echo -e "${BOLD}╚═══════════════════════════════════════════════════════════╝${NC}"
echo ""
