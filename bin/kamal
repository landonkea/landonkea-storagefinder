#!/usr/bin/env ruby
# Must be the literal first line of the file — the shebang that tells the
# OS to run this file with whatever `ruby` is found on the system PATH
# (fully explained in bin/brakeman; this appears atop every bin/ script).

# A "magic comment" — Ruby recognizes specially-formatted comments like
# this one (it must be near the top of the file) as instructions to the
# interpreter itself, not just as human documentation. `frozen_string_literal:
# true` makes every plain string literal in this file (e.g. "kamal" below)
# immutable by default — trying to modify one in place would raise an
# error instead of silently changing shared data. This is a common
# performance/safety convention in modern Ruby gems.
# frozen_string_literal: true

# The comment block below was written by Bundler itself when it generated
# this file (this happens automatically when the `kamal` gem is added to
# the Gemfile) — preserved here as useful context, not something this
# project's developers wrote by hand.
#
# This file was generated by Bundler.
#
# The application 'kamal' is installed as part of a gem, and
# this file is here to facilitate running it.
#

# `ENV` is a hash-like object giving access to environment variables —
# key/value settings inherited from the shell/OS process this script runs
# in (e.g. `ENV["HOME"]`). `ENV["BUNDLE_GEMFILE"]` tells Bundler which
# Gemfile to use. `||=` is Ruby's "or-assign": it only sets the value on
# the left if it's currently nil/false — so this line says "if
# BUNDLE_GEMFILE isn't already set in the environment, set it to the path
# of the Gemfile in this app's root." `File.expand_path("../Gemfile",
# __dir__)` builds that path: `__dir__` is a special Ruby variable equal
# to the directory this very file (bin/kamal) lives in, and
# `File.expand_path("../Gemfile", __dir__)` resolves "go up one directory
# from bin/, then find Gemfile" into a full absolute path. This ensures
# Kamal (a deployment tool) always uses THIS project's Gemfile, even if
# it's invoked from some other working directory.
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

# Blank line separating environment setup from library loading.

# Loads RubyGems, Ruby's built-in package manager library, ensuring the
# `Gem` module (used below) is available.
require "rubygems"
# Loads Bundler's setup code, which restricts `require` to only see the
# exact gem versions locked in this project's Gemfile.lock — preventing
# version mismatches with gems installed elsewhere on the system.
require "bundler/setup"

# Blank line before the final "hand off control to the real tool" step.

# `Gem.bin_path("kamal", "kamal")` asks RubyGems for the full file path of
# the executable named "kamal" that belongs to the gem also named
# "kamal", using the exact version locked by Bundler above. `load` then
# reads and runs that file's code as if it were pasted right here. This
# is the same wrapper pattern used by bin/brakeman, bin/rubocop, and
# bin/thrust — it exists so `bin/kamal` always runs the exact Kamal
# version this project depends on, rather than whatever `kamal` command
# happens to be first on the system PATH.
load Gem.bin_path("kamal", "kamal")
